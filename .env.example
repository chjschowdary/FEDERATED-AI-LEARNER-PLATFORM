# FederAI Cloud — Environment Configuration Template

# Operational Environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
JWT_SECRET=FEDERAI-CLOUD-SECURE-DEVELOPMENT-SECRET-KEY-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
DATABASE_URL=postgresql://federai:federai_secure_pass_2026@localhost:5432/federaicloud
# SQLite Fallback (Optional): sqlite:///./federaicloud.db

# Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# S3-Compatible Object Storage (SeaweedFS / AWS S3)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET_NAME=federaicloud-artifacts
AWS_ACCESS_KEY_ID=seaweedadmin
AWS_SECRET_ACCESS_KEY=seaweedsecurepass2026
AWS_REGION=us-east-1

# Federated Training Defaults
DEFAULT_MAX_ROUNDS=20
DEFAULT_TARGET_ACCURACY=0.88
DEFAULT_AGGREGATION_STRATEGY=FedAvg
DEFAULT_DP_EPSILON=1.0
DEFAULT_DP_DELTA=0.00001
DEFAULT_DP_CLIP_NORM=1.0
DEFAULT_BYZANTINE_FILTER=true
