# ==============================================================================
# Production Dockerfile for FederAI Cloud Frontend SPA (Nginx)
# ==============================================================================

FROM nginx:alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx reverse proxy config
COPY <<EOF /etc/nginx/conf.d/federaicloud.conf
server {
    listen 80;
    server_name localhost;

    # Root location with no-cache headers to prevent stale SPAs
    location / {
        root /usr/share/nginx/html;
        index index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        add_header Pragma "no-cache";
        expires -1;
        try_files \$uri \$uri/ /index.html;
    }

    # Static assets alias with no-cache for instant live development
    location /static/ {
        alias /usr/share/nginx/html/;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        add_header Pragma "no-cache";
        expires -1;
        try_files \$uri \$uri/ =404;
    }

    # Proxy API requests to backend
    location /api/ {
        proxy_pass http://api-gateway:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }

    # Proxy WebSocket telemetry
    location /api/ws {
        proxy_pass http://api-gateway:8000/api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host \$host;
    }

    # Direct proxy to SeaweedFS Filer (port 8888)
    location /filer/ {
        proxy_pass http://seaweedfs:8888/;
        proxy_set_header Host \$host;
    }

    # Direct proxy to SeaweedFS Master (port 9333)
    location /master/ {
        proxy_pass http://seaweedfs:9333/;
        proxy_set_header Host \$host;
    }
}
EOF

# Copy static frontend files
COPY frontend/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:80/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
